# Application Settings
APP_NAME=Book Review API
CORS_ORIGINS=["http://localhost:3000"]

# Database Connection (MySQL)
DATABASE_URL=mysql+pymysql://appuser:apppassword@localhost:3306/book_review

# Docker Compose MySQL Settings
MYSQL_DATABASE=book_review
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306

# Auth & JWT Security (generate a strong random secret in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
